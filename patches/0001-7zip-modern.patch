+  void ReadToolbar()
+  {
+    const UInt32 mask = ReadToolbarsMask();
+    // Bit 4 marks the modern layout. Configs written by the classic UI have
+    // it clear, so they are migrated once to the new icon-only defaults
+    // instead of dragging the old "show button text" flag along.
+    if ((mask & 0x10) == 0)
+    {
+      ShowButtonsLables = false;
+      LargeButtons = false;
+      ShowStandardToolbar = ShowArchiveToolbar = true;
+    }
+    else
+    {
+      ShowButtonsLables = ((mask & 1) != 0);
+      LargeButtons = ((mask & 2) != 0);
+      ShowStandardToolbar = ((mask & 4) != 0);
+      ShowArchiveToolbar  = ((mask & 8) != 0);
+    }
+  }
+  void SaveToolbar()
+  {
+    UInt32 mask = 0x10; // modern layout marker
+    if (ShowButtonsLables) mask |= 1;
+    if (LargeButtons) mask |= 2;
+    if (ShowStandardToolbar) mask |= 4;
+    if (ShowArchiveToolbar) mask |= 8;
+    SaveToolbarsMask(mask);
+  }

+bool CPanel::OnNotifyReBar(LPNMHDR header, LRESULT & /* result */)
+{
+  switch (header->code)
+  {
+    case RBN_HEIGHTCHANGE:
+    {
+      RECT rect;
+      GetWindowRect(&rect);
+      ChangeWindowSize(RECT_SIZE_X(rect), RECT_SIZE_Y(rect));
+      return false;
+    }
+  }
+  return false;
+}

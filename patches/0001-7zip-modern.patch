+// ---------------------------------------------------------------- 7-Zip Modern
+// macOS-style row painting lives in OnCustomDraw below.
+
+bool CPanel::OnCustomDraw(LPNMLVCUSTOMDRAW lplvcd, LRESULT &result)
+{
+  switch (lplvcd->nmcd.dwDrawStage)
+  {
+  case CDDS_PREPAINT :
+    result = CDRF_NOTIFYITEMDRAW;
+    return true;
+
+  case CDDS_ITEMPREPAINT:
+  {
+    const unsigned realIndex = (unsigned)lplvcd->nmcd.lItemlParam;
+    const bool isSelected = (lplvcd->nmcd.uItemState & CDIS_SELECTED) != 0;
+
+    if (_markDeletedItems && _thereAreDeletedItems)
+    {
+      if (IsItem_Deleted(realIndex))
+        lplvcd->clrText = RGB(255, 0, 0);
+    }
+
+    // Multi-select mode keeps its own highlight so picked items stay obvious.
+    if (_mySelectMode)
+    {
+      if (realIndex != kParentIndex && _selectedStatusVector[realIndex])
+      {
+        lplvcd->clrTextBk = RGB(255, 192, 192);
+        result = CDRF_NEWFONT;
+        return true;
+      }
+    }
+
+    // macOS-like selection: a solid accent fill with a white label instead
+    // of the system's navy highlight. Everything else stays system drawn.
+    if (isSelected)
+    {
+      lplvcd->clrText = RGB(0xFF, 0xFF, 0xFF);
+      lplvcd->clrTextBk = NModernUI::Col_Accent();
+      result = CDRF_NEWFONT;
+      return true;
+    }
+
+    // no alternating tint: the Finder look keeps the content area pure white
+    lplvcd->clrTextBk = _listView.GetBkColor();
+    result = CDRF_NEWFONT;
+    return true;
+  }
+  }
+  return false;
+}

+void CApp::ReloadToolbars()
+{
+  _toolBar.Destroy();
+
+  if (!ShowArchiveToolbar && !ShowStandardToolbar)
+    return;
+
+  if (!_toolBar.Create(_window))
+    return;
+
+  _toolBar.SetShowText(ShowButtonsLables);
+  _toolBar.SetIconSize(LargeButtons ? 32 : 28);

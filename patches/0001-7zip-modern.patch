+void CModernToolBar::AutoSize()
+{
+  if (!_hwnd)
+    return;
+  RECT rc;
+  ::GetClientRect(_parent, &rc);
+  Layout(rc.right);
+  ::SetWindowPos(_hwnd, NULL, 0, _top, rc.right, _barHeight,
+      SWP_NOZORDER | SWP_NOACTIVATE);
+}

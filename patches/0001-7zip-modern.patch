+// 7-Zip Modern: column widths are derived from the font metrics instead of
+// being frozen at the pixel sizes that suited the old 16px-icon list. Without
+// this the larger list font truncates every name to "docum...".
+static int Modern_ColumnScale()
+{
+  static int scale = 0;
+  if (scale != 0)
+    return scale;
+
+  scale = 100;
+  NONCLIENTMETRICSW ncm;
+  ncm.cbSize = sizeof(ncm);
+  if (::SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0))
+  {
+    int h = ncm.lfMessageFont.lfHeight;
+    if (h < 0)
+      h = -h;
+    if (h < 1)
+      h = 12;
+    // the list font used by the panel is h * 14 / 12, see Panel.cpp
+    const int listHeight = h * 14 / 12;
+    scale = listHeight * 100 / 12;
+    if (scale < 100)
+      scale = 100;
+    if (scale > 250)
+      scale = 250;
+  }
+  return scale;
+}
+
 static unsigned GetColumnWidth(PROPID propID, VARTYPE /* varType */)
 {
+  unsigned base;
   switch (propID)
   {
-    case kpidName: return 160;
+    // Roomy enough for "some_long_document_name.txt" without truncation.
+    case kpidName: base = 210; break;
+    // Date/size columns need to fit "2026-11-09 14:12" at the larger font.
+    default: base = 118; break;
   }
-  return 100;
+  return (unsigned)((UInt64)base * (unsigned)Modern_ColumnScale() / 100);
 }
 
